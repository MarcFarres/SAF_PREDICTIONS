# Copiar a .env en esta misma carpeta ( .env está en .gitignore ).
# Luego: pip install -r requirements.txt  y  uvicorn api:app --host 127.0.0.1 --port 8000

AWS_REGION=eu-west-1

# Opción A: credenciales explícitas (solo local; nunca subas .env)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Opción B: perfil AWS CLI (~/.aws/credentials)
# AWS_PROFILE=nombre_perfil

S3_WEIGHTS_BUCKET=ag-zoom-sensor-ml-eu-west-1
S3_WEIGHTS_PREFIX=models/weights

# Solo desarrollo: omitir HeadBucket al arrancar (train/predict siguen necesitando S3).
# S3_SKIP_STARTUP_VALIDATION=1
